# ============================================================
# Navigate AI — Environment Variables Configuration
# ============================================================

# Application Environment (development | production | testing)
APP_ENV=development
SECRET_KEY=navigate-ai-super-secret-key-32-chars-minimum
LOG_LEVEL=INFO

# Backend API URL
API_PORT=8000
API_HOST=127.0.0.1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Database Configuration
# Default async SQLite for immediate local zero-dependency execution:
DATABASE_URL=sqlite+aiosqlite:///./navigate_ai.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://navigate:navigate_pass@localhost:5432/navigate_ai

# Redis (Optional: for background workers and caching)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=navigate-ai-jwt-secret-key-2026-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Datasets
DATASET_DIR=./datasets
DEMO_DATASET_PATH=./datasets/demo
RXR_DATASET_PATH=./datasets/rxr

# Optional External Multimodal LLM Providers (Not required for local baseline)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# HUGGINGFACE_TOKEN=
